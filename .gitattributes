# Auto detect text files and perform LF normalization
* text=auto

# Force LF for source files
*.md   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.sh   text eol=lf
*.fish text eol=lf
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.typ  text eol=lf

# Hugo build lock (binary, no conversion)
.hugo_build.lock text eol=lf

# Binary files - do not modify
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
